---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---

<Base title="Fabián Godoy · fabgs.dev">
  <section class="hero">
    <h1>Hola, soy Fabián.</h1>
    <p>
      Desarrollador de software. Aquí recojo los proyectos que voy publicando,
      desde simulaciones en C compiladas a WebAssembly hasta herramientas web.
    </p>
  </section>

  <section class="section" id="proyectos">
    <h2>Proyectos</h2>
    <div class="grid">
      {
        projects.map((p) => (
          <article class="card">
            <h3><a href={p.path}>{p.title}</a></h3>
            <p>{p.description}</p>
            <ul class="tags">
              {p.tags.map((t) => <li>{t}</li>)}
            </ul>
            <div class="card-links">
              <a href={p.path}>Abrir →</a>
              <a href={p.repo} target="_blank" rel="noopener">Código</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>
