---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site, socialLinks } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const home = getRelativeLocaleUrl(lang, '');
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={home}>{site.domain}</a>

    <nav class="nav label">
      <a href={`${home}#projects`}>{t('nav.projects')}</a>
      {
        socialLinks.map((s) => (
          <a href={s.href} rel="me noopener" target="_blank">
            {s.label}
          </a>
        ))
      }
    </nav>

    <div class="lang">
      <LangSwitch lang={lang} path={path} />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--rule-w) solid var(--rule);
  }

  .container {
    display: grid;
    grid-template-columns: 1fr auto auto;
    column-gap: 2rem;
    align-items: center;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
  }

  .brand {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand::before {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    background: var(--red);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  .nav a {
    border-bottom: 2px solid transparent;
    padding-bottom: 0.15rem;
  }

  .nav a:hover {
    border-color: var(--red);
  }

  .lang {
    padding-left: 2rem;
    border-left: 1px solid var(--rule);
  }

  /* Móvil: marca e idioma en la primera fila, enlaces en una segunda fila
     con su propia regla. Nada queda fuera de pantalla. */
  @media (max-width: 40rem) {
    .container {
      grid-template-columns: 1fr auto;
      row-gap: 0.85rem;
      padding-bottom: 0.9rem;
    }

    .nav {
      grid-column: 1 / -1;
      gap: 0.5rem 1.25rem;
      padding-top: 0.85rem;
      border-top: 1px solid var(--rule);
    }

    .lang {
      grid-column: 2;
      grid-row: 1;
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
