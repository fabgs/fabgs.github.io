---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site, socialLinks } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const home = getRelativeLocaleUrl(lang, '');
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={home}>{site.domain}</a>

    <nav class="nav label">
      <a href={`${home}#projects`}>{t('nav.projects')}</a>
      <a href={`${home}#experience`}>{t('nav.experience')}</a>
      <a href={`${home}#about`}>{t('nav.about')}</a>
      <a href={`${home}#contact`}>{t('nav.contact')}</a>
      {
        socialLinks.map((s) => (
          <a href={s.href} rel="me noopener" target="_blank">
            {s.label}
          </a>
        ))
      }
    </nav>

    <div class="lang">
      <LangSwitch lang={lang} path={path} />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule-soft);
    /* Fija arriba al hacer scroll; franja sólida de lado a lado, por encima del
       contenido y del campo de puntos de los márgenes */
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
  }

  .container {
    display: grid;
    grid-template-columns: 1fr auto auto;
    column-gap: 2rem;
    align-items: center;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
  }

  .brand {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand::before {
    content: '';
    width: 0.7rem;
    height: 0.7rem;
    background: var(--red);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.9rem;
  }

  .nav a {
    color: var(--ink-soft);
    transition: color 0.15s;
  }

  .nav a:hover {
    color: var(--ink);
  }

  .lang {
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule-soft);
  }

  /* Móvil: marca e idioma en la primera fila, enlaces en una segunda fila
     con su propia regla. Nada queda fuera de pantalla. */
  /* Móvil: marca e idioma en la primera fila; los enlaces, en una sola fila
     que se desliza de lado, para que la cabecera fija ocupe poco alto. */
  @media (max-width: 40rem) {
    .container {
      grid-template-columns: 1fr auto;
      row-gap: 0.6rem;
      padding-top: 0.9rem;
      padding-bottom: 0.6rem;
    }

    .nav {
      grid-column: 1 / -1;
      flex-wrap: nowrap;
      gap: 1.25rem;
      overflow-x: auto;
      scrollbar-width: none;
      padding-top: 0.6rem;
      border-top: 1px solid var(--rule-soft);
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    .nav a {
      white-space: nowrap;
    }

    .lang {
      grid-column: 2;
      grid-row: 1;
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
