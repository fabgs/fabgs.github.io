---
/**
 * Un cuadrado rojo que es una puerta: sin etiqueta visible, con nombre
 * accesible. Al pasar el ratón aparece el pomo; al pulsar, la hoja gira
 * sobre su bisagra, el hueco se expande hasta llenar la pantalla y se navega.
 * El tamaño y la posición los decide quien lo usa a través de `class`.
 */
interface Props {
  href: string;
  label: string;
  class?: string;
  style?: string;
}

const { href, label, class: className, style } = Astro.props;
---

<a class:list={['door', className]} href={href} style={style} aria-label={label}>
  <span class="way"></span>
  <span class="leaf"></span>
</a>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Al volver con "atrás", el navegador restaura la página tal y como quedó,
  // con la puerta abierta. Se cierra de nuevo.
  window.addEventListener('pageshow', () => {
    document.querySelectorAll('.door.opening').forEach((d) => d.classList.remove('opening'));
  });

  document.querySelectorAll<HTMLAnchorElement>('.door').forEach((door) => {
    door.addEventListener('click', (e) => {
      // Clic normal: primero se abre la puerta, después se atraviesa.
      if (reduced || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      door.classList.add('opening');
      // Se navega en cuanto la hoja termina de abrirse (tope por si el evento no llega)
      const leaf = door.querySelector('.leaf')!;
      let done = false;
      const go = () => {
        if (done) return;
        done = true;
        location.href = door.href;
      };
      leaf.addEventListener('transitionend', go, { once: true });
      setTimeout(go, 900);
    });
  });
</script>

<style>
  .door {
    position: relative;
    display: block;
    perspective: 40rem;
  }

  .way,
  .leaf {
    position: absolute;
    inset: 0;
    display: block;
  }

  /* El hueco: la luz que se ve al abrir la puerta */
  .way {
    background: var(--ink);
    visibility: hidden;
  }

  /* La hoja gira sobre su lado izquierdo */
  .leaf {
    background: var(--red);
    transform-origin: left center;
    transition: transform 0.65s cubic-bezier(0.5, 0, 0.15, 1);
  }

  /* El pomo, solo al pasar el ratón o enfocar con teclado */
  .leaf::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 18%;
    width: 14%;
    height: 14%;
    max-width: 0.6rem;
    max-height: 0.6rem;
    transform: translateY(-50%) scale(0);
    background: var(--ink);
    transition: transform 0.2s;
  }

  .door:hover .leaf::after,
  .door:focus-visible .leaf::after {
    transform: translateY(-50%) scale(1);
  }

  .door.opening {
    z-index: 50;
  }

  .door.opening .leaf {
    transform: rotateY(-88deg);
  }

  .door.opening .way {
    visibility: visible;
  }
</style>
