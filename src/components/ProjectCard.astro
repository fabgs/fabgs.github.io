---
import type { Project } from '../data/projects';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  /** Posición en el índice, empezando en 1 */
  index: number;
}

const { project, lang, index } = Astro.props;
const t = useTranslations(lang);

const isExternal = (href: string) => /^https?:\/\//.test(href);

// Destino de la tarjeta entera: la demo si existe, si no el primer repositorio.
const primary = project.live ?? project.repos[0].href;
const primaryExternal = isExternal(primary);
const primaryLabel = t(project.live ? 'card.open' : 'card.code');

// Botones de repositorio: se ocultan si la tarjeta ya lleva a ese único repo.
const repoButtons = project.live || project.repos.length > 1 ? project.repos : [];
---

<article class="card">
  <span class="index label">{String(index).padStart(2, '0')}</span>
  <h3>
    <a
      href={primary}
      target={primaryExternal ? '_blank' : undefined}
      rel={primaryExternal ? 'noopener' : undefined}
    >
      {project.title[lang]}
    </a>
  </h3>
  <p>{project.description[lang]}</p>
  <ul class="tags label">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <div class="foot label">
    <span class="open">{primaryLabel}</span>
    {
      repoButtons.length > 0 && (
        <span class="repos">
          {repoButtons.map((r) => (
            <a class="code" href={r.href} target="_blank" rel="noopener">
              {r.label ? `${r.label} →` : t('card.code')}
            </a>
          ))}
        </span>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: 1rem;
    padding: 1.5rem var(--gutter) 1.75rem;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
    transition: background 0.15s, color 0.15s;
  }

  .card:hover,
  .card:focus-within {
    background: var(--ink);
    color: var(--paper);
  }

  .index {
    color: var(--red);
  }

  h3 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  /* Enlace estirado: el título es el enlace y su ::after cubre toda la tarjeta.
     Así toda la tarjeta lleva al destino sin anidar enlaces. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Por encima de cualquier hijo que cree su propia capa (opacity, transform) */
    z-index: 1;
  }

  p {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.5;
    max-width: 34rem;
  }

  .card:hover p,
  .card:focus-within p {
    color: inherit;
    opacity: 0.8;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tags li + li::before {
    content: '/';
    margin-right: 0.6rem;
    color: var(--red);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    padding-top: 1rem;
    border-top: 1px solid currentColor;
  }

  /* Misma altura que un botón (padding + borde), aunque sea solo texto:
     así el pie mide igual en todas las tarjetas y la regla superior queda
     alineada entre las tarjetas de una misma fila. */
  .open {
    color: var(--red);
    padding: 0.35rem 0;
    border-top: 2px solid transparent;
    border-bottom: 2px solid transparent;
    transition: transform 0.15s;
  }

  .card:hover .open {
    transform: translateX(0.25rem);
  }

  .repos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Los botones de repositorio quedan por encima del enlace estirado */
  .code {
    position: relative;
    z-index: 2;
    padding: 0.35rem 0.75rem;
    border: 2px solid currentColor;
    white-space: nowrap;
  }

  .code:hover {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
  }
</style>
