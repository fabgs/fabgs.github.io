---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  /** Posición en el índice, empezando en 1 */
  index: number;
}

const { project, lang, index } = Astro.props;
const t = useTranslations(lang);

const isExternal = (href: string) => /^https?:\/\//.test(href);

// Destino de la tarjeta entera: la demo si existe, si no el primer repositorio.
const primary = project.live ?? project.repos[0].href;
const primaryExternal = isExternal(primary);
const primaryLabel = t(project.live ? 'card.open' : 'card.code');

// Botones de repositorio: se ocultan si la tarjeta ya lleva a ese único repo.
const repoButtons = project.live || project.repos.length > 1 ? project.repos : [];
---

<article class="card">
  {
    project.image && (
      <Image
        class="shot"
        src={project.image.src}
        alt={project.image.alt[lang]}
        widths={[480, 800, 1280]}
        sizes="(max-width: 48rem) 100vw, 36rem"
        loading="lazy"
      />
    )
  }
  <span class="index label">{String(index).padStart(2, '0')}</span>
  <h3>
    <a
      href={primary}
      target={primaryExternal ? '_blank' : undefined}
      rel={primaryExternal ? 'noopener' : undefined}
    >
      {project.title[lang]}
    </a>
  </h3>
  <div class="body">
    <p>{project.description[lang]}</p>
    {
      project.role && (
        <p class="role">
          <span class="label">{t('card.role')}</span> {project.role[lang]}
        </p>
      )
    }
  </div>
  <ul class="slashes label">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <div class="foot label">
    <span class="open">{primaryLabel}</span>
    {
      repoButtons.length > 0 && (
        <span class="repos">
          {repoButtons.map((r) => (
            <a class="code" href={r.href} target="_blank" rel="noopener">
              {r.label ? `${r.label} →` : t('card.code')}
            </a>
          ))}
        </span>
      )
    }
  </div>
</article>

<style>
  /* En columna: la descripción crece y empuja etiquetas y pie hacia abajo,
     así el pie queda alineado entre las dos tarjetas de una fila. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    /* sin esto, la tarjeta crecería hasta el ancho original de su captura */
    min-width: 0;
    gap: 1rem;
    padding: 1.5rem var(--gutter) 1.75rem;
    border-bottom: 1px solid var(--rule-soft);
    transition: background 0.15s;
  }

  /* Al pasar por encima: un velo suave sobre la banda y el título en rojo */
  .card:hover,
  .card:focus-within {
    background: var(--hover);
  }

  .index {
    color: var(--ink-faint);
  }

  h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    transition: color 0.15s;
  }

  .card:hover h3,
  .card:focus-within h3 {
    color: var(--red);
  }

  /* Enlace estirado: el título es el enlace y su ::after cubre toda la tarjeta.
     Así toda la tarjeta lleva al destino sin anidar enlaces. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Por encima de cualquier hijo que cree su propia capa (opacity, transform) */
    z-index: 1;
  }

  /* Captura de la demo, siempre en 16:10 */
  .shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--rule-soft);
    margin-bottom: 0.25rem;
  }

  .body {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  p {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.5;
    max-width: 34rem;
  }

  .role {
    font-size: 0.9rem;
  }

  .role .label {
    color: var(--ink);
    font-weight: 600;
    margin-right: 0.35rem;
  }

  .slashes {
    color: var(--ink-soft);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule-soft);
  }

  /* Misma altura que un botón (padding + borde), aunque sea solo texto:
     así el pie mide igual en todas las tarjetas y la regla superior queda
     alineada entre las tarjetas de una misma fila. */
  .open {
    color: var(--red);
    font-weight: 600;
    padding: 0.35rem 0;
    border-top: 1px solid transparent;
    border-bottom: 1px solid transparent;
    transition: transform 0.15s;
  }

  .card:hover .open {
    transform: translateX(0.25rem);
  }

  .repos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Los botones de repositorio quedan por encima del enlace estirado */
  .code {
    position: relative;
    z-index: 2;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--rule);
    font-weight: 600;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s;
  }

  .code:hover {
    border-color: var(--red);
    color: var(--red);
  }
</style>
