---
/** Franja de datos rápidos del hero: dónde vivo, disponibilidad, idioma. */
import { facts } from '../data/cv';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<dl class="facts">
  {
    facts.map((f) => (
      <div>
        <dt class="label">{f.label[lang]}</dt>
        <dd class="value">{f.value[lang]}</dd>
        <dd class="note">{f.note[lang]}</dd>
      </div>
    ))
  }
</dl>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem var(--gutter);
    margin: 3rem 0 0;
  }

  .facts div {
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
  }

  dt {
    color: var(--red);
  }

  dd {
    margin: 0;
  }

  .value {
    margin-top: 0.4rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .note {
    margin-top: 0.2rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  @media (max-width: 48rem) {
    .facts {
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }
  }
</style>
