---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import MarginField from './MarginField.astro';
import Door from './Door.astro';
import Section from './Section.astro';
import Facts from './Facts.astro';
import Entries from './Entries.astro';
import Skills from './Skills.astro';
import Contact from './Contact.astro';
import { projects } from '../data/projects';
import { experience, education } from '../data/cv';
import { site } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} title={`${site.name} · ${site.domain}`}>
  <section class="hero grid-12">
    <span class="index label">{t('hero.index')}</span>
    <h1>Fabián<br />Godoy<em>.</em></h1>
    <Door class="mark mark-door" href={getRelativeLocaleUrl(lang, 'guestbook')} label={t('guestbook.title')} />
    <span class="mark mark-plain" aria-hidden="true"></span>
    <p>{t('hero.tagline')}</p>
    <Facts lang={lang} />
  </section>

  <Section id="projects" index={t('projects.index')} title={t('projects.title')}>
    <div class="projects">
      {projects.map((p, i) => <ProjectCard project={p} lang={lang} index={i + 1} />)}
    </div>
  </Section>

  <Section id="experience" index={t('experience.index')} title={t('experience.title')}>
    <Entries entries={experience} lang={lang} />
  </Section>

  <Section id="skills" index={t('skills.index')} title={t('skills.title')}>
    <Skills lang={lang} />
  </Section>

  <Section id="education" index={t('education.index')} title={t('education.title')}>
    <Entries entries={education} lang={lang} />
  </Section>

  <Section id="contact" index={t('contact.index')} title={t('contact.title')}>
    <Contact lang={lang} />
  </Section>

  <MarginField lang={lang} />
</Base>

<style>
  /* Dos columnas en escritorio, una en móvil. Las reglas verticales se dibujan
     con bordes en las tarjetas impares para que las celdas vacías queden limpias. */
  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .projects > :global(.card:nth-child(odd)) {
    border-right: 1px solid var(--rule);
  }

  @media (max-width: 48rem) {
    .projects {
      grid-template-columns: 1fr;
    }

    .projects > :global(.card:nth-child(odd)) {
      border-right: 0;
    }
  }
</style>
