---
/** Cierre de la portada: qué busco, el email bien grande y el resto de enlaces. */
import { site, socialLinks } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="contact grid-12">
  <p>{t('contact.text')}</p>
  <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
  <ul class="links">
    <li>
      <a class="btn btn-primary" href={site.cv} target="_blank" rel="noopener">
        {t('contact.cv')} ↓
      </a>
    </li>
    {
      socialLinks.map((s) => (
        <li>
          <a class="btn" href={s.href} target="_blank" rel="me noopener">
            {s.label} →
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .contact {
    padding: 2rem 0 0;
    row-gap: 1.5rem;
  }

  p {
    grid-column: 3 / span 7;
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .email {
    grid-column: 3 / -1;
    justify-self: start;
    max-width: 100%;
    font-size: clamp(1.5rem, 4.5vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    overflow-wrap: anywhere;
    border-bottom: 2px solid var(--red);
    transition: color 0.15s;
  }

  .email:hover {
    color: var(--red);
  }

  .links {
    grid-column: 3 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  @media (max-width: 40rem) {
    p,
    .email,
    .links {
      grid-column: 1 / -1;
    }
  }
</style>
